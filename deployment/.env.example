# =============================================================================
# Troco deployment — copier vers .env et renseigner les secrets
#   cp .env.example .env
# =============================================================================

# ----- Ports exposés -----
HTTP_PORT=80
HTTPS_PORT=443
MINIO_CONSOLE_PORT=9001

# ----- Postgres -----
DB_NAME=troco
DB_USERNAME=troco
DB_PASSWORD=change-me-strong-db-password

# ----- JWT (min. 32 caractères) -----
APP_JWT_SECRET=change-me-to-a-long-random-secret-key-32chars

# ----- MinIO -----
MINIO_ACCESS_KEY=trocominio
MINIO_SECRET_KEY=change-me-strong-minio-secret
MINIO_BUCKET=troco-uploads
MINIO_PUBLIC_READ=true
# URL publique des fichiers (via Nginx /files/ → MinIO)
MINIO_PUBLIC_ENDPOINT=https://troco.ma/files

# ----- App -----
APP_PUBLIC_SITE_URL=https://troco.ma
APP_CORS_ALLOWED_ORIGINS=https://troco.ma,https://www.troco.ma,https://*.troco.ma

# ----- Mail (optionnel) -----
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SENDER_NAME=Troco

# ----- Observabilité -----
OTEL_SDK_DISABLED=true
