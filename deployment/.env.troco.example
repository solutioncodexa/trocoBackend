# =============================================================================
# Troco / Matjarona — secrets VPS (NE PAS COMMITTER le vrai .env.troco)
# Sur le serveur : cp .env.troco.example .env.troco && nano .env.troco
#
# DNS actuel : getstore.codexa-solution.com + api.getstore.codexa-solution.com
# SMTP = même LWS que GoldYara / autres apps Codexa (mail.goldyara.com:465 SSL).
# =============================================================================

# ----- Domaine public -----
TROCO_DOMAIN=getstore.codexa-solution.com
TROCO_WWW_DOMAIN=getstore.codexa-solution.com
APP_PUBLIC_SITE_URL=https://getstore.codexa-solution.com
APP_CORS_ALLOWED_ORIGINS=https://getstore.codexa-solution.com,https://*.getstore.codexa-solution.com,https://api.getstore.codexa-solution.com
APP_PLATFORM_DOMAIN=getstore.codexa-solution.com
APP_PLATFORM_NAME=Matjarona

# ----- JWT / admin -----
APP_JWT_SECRET=__CHANGE_ME_LONG_RANDOM_BASE64_OR_HEX__
APP_JWT_EXPIRATION_MS=86400000
APP_JWT_REFRESH_EXPIRATION_MS=604800000
APP_ADMIN_EMAIL=admin@getstore.codexa-solution.com
APP_ADMIN_PASSWORD=__CHANGE_ME_ADMIN__
APP_SUPER_ADMIN_EMAIL=superadmin@matjarona.ma
APP_SUPER_ADMIN_PASSWORD=__CHANGE_ME_SUPER_ADMIN__

# ----- Postgres prod (conteneur troco-postgres) -----
TROCO_DB_NAME=troco
TROCO_DB_USERNAME=troco
TROCO_DB_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__
TROCO_DB_DDL_AUTO=validate
DB_POOL_MAX=20
DB_POOL_MIN=5

# Alias lus aussi par Spring (env_file) — garder alignés avec TROCO_DB_*
DB_URL=jdbc:postgresql://troco-postgres:5432/troco
DB_USERNAME=troco
DB_PASSWORD=__CHANGE_ME_STRONG_DB_PASSWORD__

# ----- MinIO dédié Troco -----
TROCO_MINIO_ACCESS_KEY=trocominio
TROCO_MINIO_SECRET_KEY=__CHANGE_ME_STRONG_MINIO_SECRET__
TROCO_MINIO_BUCKET=troco-uploads
TROCO_MINIO_PUBLIC_READ=true
TROCO_MINIO_PUBLIC_ENDPOINT=https://getstore.codexa-solution.com/files
MINIO_ACCESS_KEY=trocominio
MINIO_SECRET_KEY=__CHANGE_ME_STRONG_MINIO_SECRET__
MINIO_BUCKET=troco-uploads
MINIO_PUBLIC_ENDPOINT=https://getstore.codexa-solution.com/files
MINIO_REGION=us-east-1

# ----- Mail SMTP partagé (même stack LWS que GoldYara) -----
MAIL_HOST=mail.goldyara.com
MAIL_PORT=465
MAIL_USERNAME=noreply@goldyara.com
MAIL_PASSWORD=__SAME_AS_GOLDYARA_MAIL_PASSWORD__
MAIL_SSL=true
MAIL_STARTTLS=false
MAIL_STARTTLS_REQUIRED=false
MAIL_SSL_TRUST=*
MAIL_SENDER_NAME=Matjarona
MAIL_SMTP_AUTH=true

# ----- Divers -----
TROCO_OTEL_SDK_DISABLED=true
CMI_TEST_PASS=false
CMI_ENABLED=false
